---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Icono from '../components/Icono.astro';
import foto from '../assets/manuela.jpg';
// Fuentes del título y del texto: se precargan para que el título no salte cuando llegan.
import fuenteTitulos from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { proyectos, otros, pasos, stack, practicas, camino } from '../data/proyectos.js';

const correo = 'robledocordoba123@gmail.com';
const linkedin = 'https://www.linkedin.com/in/manuela-cordoba-dev/';
const github = 'https://github.com/robledocordoba123-cmyk';
const cv = '/HV_Manuela_Cordoba_Robledo.pdf';
const descripcion =
  'Manuela Córdoba Robledo, desarrolladora backend y full stack en Medellín. Java, Spring Boot, Node.js, React y PostgreSQL. Proyectos en vivo con pruebas automáticas y despliegue en la nube.';

// Logos que desfilan en la cinta de tecnologías (se repiten para que el movimiento sea continuo).
const cinta = stack.flatMap((g) => g.items);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manuela Córdoba Robledo · Desarrolladora de Software</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content="Manuela Córdoba Robledo · Desarrolladora de Software" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content="https://manuela-cordoba.vercel.app/og.png" />
    <meta property="og:image:alt" content="Portafolio de Manuela Córdoba Robledo, desarrolladora de software" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://manuela-cordoba.vercel.app/" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Manuela Córdoba Robledo" />
    <meta name="author" content="Manuela Córdoba Robledo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#050605" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fuenteTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href="https://manuela-cordoba.vercel.app/" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Manuela Córdoba Robledo',
      jobTitle: 'Desarrolladora de Software Backend y Full Stack',
      url: 'https://manuela-cordoba.vercel.app',
      image: 'https://manuela-cordoba.vercel.app/manuela.jpg',
      address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
      alumniOf: { '@type': 'EducationalOrganization', name: 'Servicio Nacional de Aprendizaje (SENA)' },
      knowsAbout: ['Java', 'Spring Boot', 'Node.js', 'React', 'PostgreSQL', 'Docker', 'C#', '.NET', 'Laravel'],
      sameAs: [linkedin, github],
    })} />
  </head>

  <body>
    <!-- Navegación -->
    <header class="nav">
      <div class="contenedor nav-interior">
        <a href="#inicio" class="marca" title="Ir al inicio">
          <span class="ecualizador pequeno" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>manuela<span class="degradado">.dev</span></span>
        </a>
        <nav aria-label="Secciones">
          <a href="#proyectos">Proyectos</a>
          <a href="#ritmo">Cómo trabajo</a>
          <a href="#stack">Stack</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#contacto" class="nav-contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Portada -->
      <section id="inicio" class="portada">
        <div class="brillo" aria-hidden="true"></div>
        <div class="contenedor portada-interior">
          <div class="portada-texto">
            <p class="disponible revelar"><span class="en-vivo">Disponible</span> para contrato de aprendizaje · abril 2027</p>
            <h1 class="revelar">
              Hola, soy <span class="degradado">Manuela</span>.
              <span class="h1-linea">Llevo el software de la idea a producción <span class="ecualizador grande" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span></span>
            </h1>
            <p class="lema revelar">
              Desarrolladora backend y full stack en Medellín. Diseño, programo, pruebo y despliego aplicaciones completas con <strong>Java y Spring Boot</strong> o <strong>Node.js y TypeScript</strong>, sobre PostgreSQL y con React.
            </p>
            <div class="acciones revelar">
              <a href="#proyectos" class="boton boton-principal">Ver mis proyectos <Icono nombre="flecha-abajo" /></a>
              <a href={cv} class="boton boton-secundario" download>Descargar CV <Icono nombre="descarga" /></a>
              <a href={github} class="icono-redondo" target="_blank" rel="noopener" aria-label="GitHub"><Icono nombre="github" /></a>
              <a href={linkedin} class="icono-redondo" target="_blank" rel="noopener" aria-label="LinkedIn"><Icono nombre="linkedin" /></a>
            </div>
          </div>

          <div class="retrato revelar">
            <div class="retrato-marco">
              <Image src={foto} alt="Manuela Córdoba Robledo" widths={[380, 560, 738]} sizes="(max-width: 420px) 100vw, 380px" loading="eager" fetchpriority="high" />
            </div>
            <p class="retrato-pie"><span class="en-vivo">En vivo</span> CuentasClaras, RitmoApp y ElCuaderno</p>
          </div>
        </div>

        <div class="contenedor">
          <dl class="cifras revelar">
            <div><dt>3</dt><dd>apps en producción</dd></div>
            <div><dt>146</dt><dd>pruebas automáticas</dd></div>
            <div><dt>13</dt><dd>Pull Requests revisados</dd></div>
            <div><dt>8+</dt><dd>proyectos en GitHub</dd></div>
          </dl>
        </div>
      </section>

      <!-- Cinta de tecnologías -->
      <div class="cinta" aria-label="Tecnologías con las que trabajo">
        <div class="cinta-pista">
          {[...cinta, ...cinta].map((t, i) => (
            <span class="cinta-item" aria-hidden={i >= cinta.length ? 'true' : undefined}>
              <img src={`/tecnologias/${t.logo}.svg`} alt="" width="22" height="22" loading="lazy" class={t.oscuro ? 'invertir' : undefined} />
              {t.nombre}
            </span>
          ))}
        </div>
      </div>

      <!-- Proyectos -->
      <section id="proyectos" class="seccion">
        <div class="contenedor">
          <span class="etiqueta">Proyectos destacados</span>
          <h2 class="titulo-seccion">Apps reales, <span class="degradado">en vivo</span>.</h2>
          <p class="intro-seccion">
            No son capturas bonitas: puedes entrar y usarlas ahora mismo con un clic, sin registrarte. Cada una resuelve un problema concreto y tiene pruebas, CI y despliegue.
          </p>

          <div class="lista-proyectos">
            {proyectos.map((p, i) => (
              <article class={`proyecto revelar ${i % 2 === 1 ? 'invertido' : ''}`} style={`--color:${p.color}`}>
                <div class="proyecto-visual">
                  <div class="ventana">
                    <div class="ventana-barra" aria-hidden="true"><span></span><span></span><span></span><em>{p.demo.replace('https://', '')}</em></div>
                    <Image src={p.imagen} alt={`Captura de ${p.nombre}`} widths={[480, 720, 1080, 1440]} sizes="(max-width: 900px) 92vw, 620px" />
                  </div>
                  <Image
                    class={p.extraEsCelular ? 'extra celular' : 'extra'}
                    src={p.imagenExtra}
                    alt={`Otra vista de ${p.nombre}`}
                    widths={p.extraEsCelular ? [180, 360] : [320, 640]}
                    sizes={p.extraEsCelular ? '170px' : '(max-width: 900px) 45vw, 300px'}
                  />
                </div>

                <div class="proyecto-texto">
                  <div class="proyecto-meta">
                    <span class="en-vivo">En vivo</span>
                    <span>{p.tipo} · {p.anio}</span>
                  </div>
                  <h3>{p.nombre}</h3>
                  <p class="frase">{p.frase}</p>

                  <dl class="caso">
                    <dt>El problema</dt><dd>{p.problema}</dd>
                    <dt>Lo que construí</dt><dd>{p.solucion}</dd>
                    <dt>Lo más difícil</dt><dd>{p.reto}</dd>
                  </dl>

                  <ul class="mini-cifras">
                    {p.cifras.map((c) => <li><strong>{c.valor}</strong> {c.texto}</li>)}
                  </ul>

                  <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>

                  <div class="acciones">
                    <a href={p.demo} class="boton boton-principal" target="_blank" rel="noopener">Probar la demo <Icono nombre="externo" /></a>
                    <a href={p.codigo} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="github" /> Ver código</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Otros proyectos -->
          <div class="otros">
            <h3 class="otros-titulo revelar">Más proyectos en mi GitHub</h3>
            <div class="otros-grid">
              {otros.map((o) => (
                <a class="otro revelar" href={o.enlace} target="_blank" rel="noopener">
                  <div class="otro-cabecera">
                    <Icono nombre="carpeta" />
                    <Icono nombre="externo" />
                  </div>
                  <h4>{o.nombre}</h4>
                  <p>{o.texto}</p>
                  <ul>{o.etiquetas.map((e) => <li>{e}</li>)}</ul>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Cómo trabajo -->
      <section id="ritmo" class="seccion ritmo">
        <div class="contenedor">
          <span class="etiqueta">Cómo trabajo</span>
          <h2 class="titulo-seccion">Mi ritmo: <span class="degradado">1, 2, 3, 4</span>.</h2>
          <p class="intro-seccion">
            Como en el baile, cada paso tiene su tiempo. Así llevo un proyecto desde la idea hasta que cualquiera puede usarlo.
          </p>
          <ol class="pasos">
            {pasos.map((paso) => (
              <li class="paso revelar">
                <span class="paso-numero">{paso.numero}</span>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </li>
            ))}
          </ol>

          <div class="terminal revelar" aria-label="Ejemplo de un cambio pasando por integración continua">
            <div class="terminal-barra"><span></span><span></span><span></span><em>manuela@medellin: ~/CuentasClaras</em></div>
            <pre><code><span class="t l1"><b>$</b> git push origin feature/presupuestos</span>
<span class="t l2"><i>→</i> Pull Request abierto: “Presupuestos con alerta al 80 %”</span>
<span class="t l3"><em class="ok">✓</em> Backend (Maven + Testcontainers) · 72 pruebas pasaron</span>
<span class="t l4"><em class="ok">✓</em> Frontend (lint + build)</span>
<span class="t l5"><em class="ok">✓</em> Revisión aprobada · merge a main</span>
<span class="t l6"><em class="ok">✓</em> Desplegado en <u>cuentasclaras-demo.vercel.app</u></span>
<span class="t l7"><b>$</b> <span class="cursor"></span></span></code></pre>
          </div>
        </div>
      </section>

      <!-- Stack -->
      <section id="stack" class="seccion">
        <div class="contenedor">
          <span class="etiqueta">Stack</span>
          <h2 class="titulo-seccion">Con qué construyo.</h2>
          <p class="intro-seccion">Lo que he aprendido en cinco trimestres del SENA y aplicado en proyectos reales: del análisis y el diseño hasta la seguridad y el despliegue.</p>
          <div class="grupos">
            {stack.map((g) => (
              <div class="grupo revelar">
                <h3>{g.grupo}</h3>
                <ul class="logos">
                  {g.items.map((t) => (
                    <li>
                      <span class="logo-baldosa"><img src={`/tecnologias/${t.logo}.svg`} alt="" width="40" height="40" loading="lazy" /></span>
                      {t.nombre}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="practicas">
            {practicas.map((p) => (
              <div class="grupo revelar">
                <h3>{p.grupo}</h3>
                <ul class="chips">{p.items.map((i) => <li class="chip">{i}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Sobre mí -->
      <section id="sobre-mi" class="seccion">
        <div class="contenedor sobre-mi">
          <div class="revelar">
            <span class="etiqueta">Sobre mí</span>
            <h2 class="titulo-seccion">Me gusta que las cosas <span class="degradado">funcionen de verdad</span>.</h2>
            <p class="sobre-mi-p">
              Estudio Tecnología en Análisis y Desarrollo de Software en el SENA (Centro de Tecnología de la Manufactura Avanzada, Medellín). Me enfoco en el backend, pero disfruto llevar un proyecto completo: entender el problema, diseñar los datos, programar, probar y dejarlo en internet.
            </p>
            <p class="sobre-mi-p">
              Me importa el detalle que no se ve: que la plata cuadre al centavo, que dos personas no puedan reservar el mismo cupo y que una contraseña nunca termine en el código.
            </p>
            <ul class="datos">
              <li><span>Ubicación</span>Medellín, Colombia</li>
              <li><span>Busco</span>Contrato de aprendizaje desde abril de 2027</li>
              <li><span>Modalidad</span>Presencial, híbrido o remoto</li>
              <li><span>Idiomas</span>Español nativo · Inglés A2 (en formación)</li>
            </ul>
          </div>

          <ol class="camino revelar" aria-label="Mi camino">
            {camino.map((c) => (
              <li class={c.destacado ? 'destacado' : ''}>
                <span class="camino-fecha">{c.fecha}</span>
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Contacto -->
      <section id="contacto" class="seccion">
        <div class="contenedor">
          <div class="contacto revelar">
            <span class="ecualizador grande" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
            <h2 class="titulo-seccion">¿Construimos algo juntos?</h2>
            <p class="intro-seccion">
              Si buscas una aprendiz que llegue a construir, probar y aprender desde el primer día, hablemos.
            </p>
            <div class="acciones centradas">
              <a href={`mailto:${correo}`} class="boton boton-principal"><Icono nombre="correo" /> Escríbeme</a>
              <a href={linkedin} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="linkedin" /> LinkedIn</a>
              <a href={github} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="github" /> GitHub</a>
              <a href={cv} class="boton boton-secundario" download><Icono nombre="descarga" /> Hoja de vida</a>
            </div>
            <p class="correo-visible">{correo}</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Barra flotante: aparece al bajar y se esconde al llegar a Contacto -->
    <div class="barra-flotante" id="barra" aria-hidden="true">
      <a href="#contacto" class="boton boton-secundario" tabindex="-1">Contactar</a>
      <a href={cv} class="boton boton-principal" download tabindex="-1">Descargar CV</a>
    </div>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <span>© 2026 Manuela Córdoba Robledo · Medellín</span>
        <span>Hecho con Astro y mucho ritmo · <a href="https://github.com/robledocordoba123-cmyk/portafolio" target="_blank" rel="noopener">código de este sitio</a></span>
      </div>
    </footer>

    <script>
      // Muestra cada bloque con una animación suave cuando entra en pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.revelar').forEach((el) => observador.observe(el));

      // Barra flotante: visible entre la portada y la sección de contacto.
      const barra = document.getElementById('barra');
      const portada = document.getElementById('inicio');
      const contacto = document.getElementById('contacto');
      let pasoPortada = false;
      let enContacto = false;
      const actualizarBarra = () => {
        const mostrar = pasoPortada && !enContacto;
        barra.classList.toggle('mostrar', mostrar);
        barra.setAttribute('aria-hidden', String(!mostrar));
        barra.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', mostrar ? '0' : '-1'));
      };
      new IntersectionObserver(([e]) => { pasoPortada = !e.isIntersecting; actualizarBarra(); }).observe(portada);
      new IntersectionObserver(([e]) => { enContacto = e.isIntersecting; actualizarBarra(); }, { threshold: 0.2 }).observe(contacto);
    </script>
  </body>
</html>

<style>
  /* Navegación */
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: rgba(5, 6, 5, .75); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(35, 43, 37, .7);
  }
  .nav-interior { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .marca { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 20px; }
  .ecualizador.pequeno { height: 18px; gap: 3px; }
  .ecualizador.pequeno span { width: 3px; }
  nav { display: flex; gap: 28px; font-size: 15px; color: var(--suave); }
  nav a { transition: color .2s; }
  nav a:hover { color: var(--texto); }
  .nav-contacto { color: var(--texto); }

  /* Portada */
  .portada { position: relative; padding: 90px 0 70px; overflow: hidden; }
  .brillo {
    /* Posición fija en px: si dependiera de la altura de la sección, se movería al cargar las fuentes. */
    position: absolute; inset: -160px -10% auto auto; width: 760px; height: 760px;
    background: radial-gradient(circle, rgba(16, 185, 129, .26), transparent 60%);
    filter: blur(20px); pointer-events: none;
  }
  .brillo::after {
    content: ''; position: absolute; left: -520px; top: 320px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(74, 222, 128, .12), transparent 60%);
  }
  .portada-interior { position: relative; display: grid; grid-template-columns: 1.2fr .8fr; gap: 50px; align-items: center; }
  .disponible {
    display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap;
    padding: 8px 16px; border-radius: 999px; background: var(--superficie); border: 1px solid var(--borde);
    font-size: 14px; color: var(--suave); margin-bottom: 28px;
  }
  h1 { font-size: clamp(40px, 5.6vw, 72px); margin-bottom: 26px; }
  .h1-linea { display: block; }
  h1 .ecualizador.grande { height: 0.72em; gap: 5px; margin-left: 8px; vertical-align: baseline; }
  h1 .ecualizador.grande span { width: 0.12em; }
  .lema { font-size: clamp(17px, 1.9vw, 20px); color: var(--suave); max-width: 620px; margin-bottom: 34px; }
  .lema strong { color: var(--texto); font-weight: 600; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .acciones.centradas { justify-content: center; }
  .icono-redondo {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--borde); background: var(--superficie); transition: border-color .2s, transform .2s;
  }
  .icono-redondo:hover { border-color: var(--acento); transform: translateY(-2px); }

  /* Retrato */
  .retrato { position: relative; justify-self: center; width: min(380px, 100%); }
  .retrato-marco {
    aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; position: relative;
    border: 1px solid var(--borde); background: var(--superficie);
    box-shadow: 0 40px 100px -40px rgba(16, 185, 129, .6);
  }
  .retrato-marco::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(5, 6, 5, .55));
  }
  .retrato-marco img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
  .retrato-pie {
    display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap;
    margin: 18px auto 0; width: fit-content; padding: 9px 18px; border-radius: 999px;
    background: var(--superficie); border: 1px solid var(--borde); font-size: 14px; color: var(--suave);
  }
  .mono { font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; }
  .ok { color: var(--acento); font-weight: 700; font-style: normal; }

  .cifras {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 70px;
    background: var(--borde); border: 1px solid var(--borde); border-radius: var(--radio); overflow: hidden;
  }
  .cifras div { background: var(--bg); padding: 24px; }
  .cifras dt { font-family: 'Space Grotesk Variable', sans-serif; font-size: 40px; font-weight: 700; }
  .cifras dd { color: var(--suave); font-size: 14px; }

  /* Cinta de tecnologías */
  .cinta {
    overflow: hidden; border-block: 1px solid var(--borde); background: var(--superficie); padding: 18px 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .cinta-pista { display: flex; gap: 44px; width: max-content; animation: desfile 45s linear infinite; }
  .cinta:hover .cinta-pista { animation-play-state: paused; }
  .cinta-item { display: inline-flex; align-items: center; gap: 10px; color: var(--suave); font-size: 15px; font-weight: 500; white-space: nowrap; }
  .cinta-item .invertir { filter: invert(1); }
  @keyframes desfile { to { transform: translateX(-50%); } }

  /* Proyectos */
  .lista-proyectos { display: grid; gap: 100px; margin-top: 64px; }
  .proyecto { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .proyecto.invertido .proyecto-visual { order: 2; }
  .proyecto-visual { position: relative; padding-bottom: 40px; }
  .ventana {
    border-radius: 14px; overflow: hidden; border: 1px solid var(--borde); background: var(--superficie);
