---
import '../styles/global.css';
import Icono from '../components/Icono.astro';
import { proyectos, pasos, stack } from '../data/proyectos.js';

const correo = 'robledocordoba123@gmail.com';
const linkedin = 'https://www.linkedin.com/in/manuela-c%C3%B3rdoba-robledo-145322418/';
const github = 'https://github.com/robledocordoba123-cmyk';
const cv = '/HV_Manuela_Cordoba_Robledo.pdf';
const descripcion =
  'Manuela Córdoba Robledo, desarrolladora backend y full stack en Medellín. Java, Spring Boot, Node.js, React y PostgreSQL. Proyectos en vivo con pruebas automáticas y despliegue en la nube.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manuela Córdoba Robledo · Desarrolladora de Software</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content="Manuela Córdoba Robledo · Desarrolladora de Software" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content="/proyectos/cuentasclaras-resumen.png" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#050605" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Navegación -->
    <header class="nav">
      <div class="contenedor nav-interior">
        <a href="#inicio" class="marca" aria-label="Inicio">
          <span class="ecualizador pequeno" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>manuela<span class="degradado">.dev</span></span>
        </a>
        <nav aria-label="Secciones">
          <a href="#proyectos">Proyectos</a>
          <a href="#ritmo">Cómo trabajo</a>
          <a href="#stack">Stack</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#contacto" class="nav-contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Portada -->
      <section id="inicio" class="portada">
        <div class="brillo" aria-hidden="true"></div>
        <div class="contenedor portada-interior">
          <p class="disponible revelar"><span class="en-vivo">Disponible</span> para contrato de aprendizaje desde abril de 2027</p>
          <h1 class="revelar">
            Hola, soy <span class="degradado">Manuela</span>.<br />
            Llevo el software de la<br class="solo-escritorio" /> idea a producción
            <span class="ecualizador grande" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
          </h1>
          <p class="lema revelar">
            Desarrolladora backend y full stack en Medellín. Diseño, programo, pruebo y despliego aplicaciones completas con <strong>Java y Spring Boot</strong> o <strong>Node.js</strong>, sobre PostgreSQL y con React.
          </p>
          <div class="acciones revelar">
            <a href="#proyectos" class="boton boton-principal">Ver mis proyectos <Icono nombre="flecha-abajo" /></a>
            <a href={cv} class="boton boton-secundario" download>Descargar CV <Icono nombre="descarga" /></a>
            <a href={github} class="icono-redondo" target="_blank" rel="noopener" aria-label="GitHub"><Icono nombre="github" /></a>
            <a href={linkedin} class="icono-redondo" target="_blank" rel="noopener" aria-label="LinkedIn"><Icono nombre="linkedin" /></a>
          </div>

          <dl class="cifras revelar">
            <div><dt>2</dt><dd>apps en producción</dd></div>
            <div><dt>119</dt><dd>pruebas automáticas</dd></div>
            <div><dt>12</dt><dd>Pull Requests revisados</dd></div>
            <div><dt>2</dt><dd>ecosistemas: Java y Node.js</dd></div>
          </dl>
        </div>
      </section>

      <!-- Proyectos -->
      <section id="proyectos" class="seccion">
        <div class="contenedor">
          <span class="etiqueta">Proyectos</span>
          <h2 class="titulo-seccion">Apps reales, <span class="degradado">en vivo</span>.</h2>
          <p class="intro-seccion">
            No son capturas bonitas: puedes entrar y usarlas ahora mismo con un clic, sin registrarte. Cada una resuelve un problema
            concreto y tiene pruebas, CI y despliegue.
          </p>

          <div class="lista-proyectos">
            {proyectos.map((p, i) => (
              <article class={`proyecto revelar ${i % 2 === 1 ? 'invertido' : ''}`} style={`--color:${p.color}`}>
                <div class="proyecto-visual">
                  <div class="ventana">
                    <div class="ventana-barra" aria-hidden="true"><span></span><span></span><span></span></div>
                    <img src={p.imagen} alt={`Captura de ${p.nombre}`} loading="lazy" width="1440" height="900" />
                  </div>
                  <img
                    class={p.extraEsCelular ? 'extra celular' : 'extra'}
                    src={p.imagenExtra}
                    alt={`Otra vista de ${p.nombre}`}
                    loading="lazy"
                  />
                </div>

                <div class="proyecto-texto">
                  <div class="proyecto-meta">
                    <span class="en-vivo">En vivo</span>
                    <span>{p.tipo} · {p.anio}</span>
                  </div>
                  <h3>{p.nombre}</h3>
                  <p class="frase">{p.frase}</p>

                  <dl class="caso">
                    <dt>El problema</dt><dd>{p.problema}</dd>
                    <dt>Lo que construí</dt><dd>{p.solucion}</dd>
                    <dt>Lo más difícil</dt><dd>{p.reto}</dd>
                  </dl>

                  <ul class="mini-cifras">
                    {p.cifras.map((c) => <li><strong>{c.valor}</strong> {c.texto}</li>)}
                  </ul>

                  <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>

                  <div class="acciones">
                    <a href={p.demo} class="boton boton-principal" target="_blank" rel="noopener">Probar la demo <Icono nombre="externo" /></a>
                    <a href={p.codigo} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="github" /> Ver código</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Cómo trabajo -->
      <section id="ritmo" class="seccion ritmo">
        <div class="contenedor">
          <span class="etiqueta">Cómo trabajo</span>
          <h2 class="titulo-seccion">Mi ritmo: <span class="degradado">1, 2, 3, 4</span>.</h2>
          <p class="intro-seccion">
            Como en el baile, cada paso tiene su tiempo. Así llevo un proyecto desde la idea hasta que cualquiera puede usarlo.
          </p>
          <ol class="pasos">
            {pasos.map((paso) => (
              <li class="paso revelar">
                <span class="paso-numero">{paso.numero}</span>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Stack -->
      <section id="stack" class="seccion">
        <div class="contenedor">
          <span class="etiqueta">Stack</span>
          <h2 class="titulo-seccion">Con qué construyo.</h2>
          <div class="grupos">
            {stack.map((g) => (
              <div class="grupo revelar">
                <h3>{g.grupo}</h3>
                <ul class="chips">{g.items.map((s) => <li class="chip">{s}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Sobre mí -->
      <section id="sobre-mi" class="seccion">
        <div class="contenedor sobre-mi">
          <div class="revelar">
            <span class="etiqueta">Sobre mí</span>
            <h2 class="titulo-seccion">Me gusta que las cosas <span class="degradado">funcionen de verdad</span>.</h2>
            <figure class="foto">
              <img src="/manuela.jpg" alt="Manuela Córdoba Robledo" width="738" height="1600" loading="lazy" />
            </figure>
          </div>
          <div class="sobre-mi-texto revelar">
            <p>
              Estudio Tecnología en Análisis y Desarrollo de Software en el SENA (Centro de Tecnología de la Manufactura Avanzada,
              Medellín). Me enfoco en el backend, pero disfruto llevar un proyecto completo: entender el problema, diseñar los datos,
              programar, probar y dejarlo en internet.
            </p>
            <p>
              Me importa el detalle que no se ve: que la plata cuadre al centavo, que dos personas no puedan reservar el mismo cupo y
              que una contraseña nunca termine en el código. Trabajo con Git por ramas y Pull Requests, y aprendo rápido de la
              revisión de otros.
            </p>
            <ul class="datos">
              <li><span>Ubicación</span>Medellín, Colombia</li>
              <li><span>Formación</span>Tecnología ADSO · SENA, 2024 – 2027</li>
              <li><span>Busco</span>Contrato de aprendizaje desde abril de 2027</li>
              <li><span>Modalidad</span>Presencial, híbrido o remoto</li>
              <li><span>Idiomas</span>Español nativo · Inglés A2 (en formación)</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Contacto -->
      <section id="contacto" class="seccion">
        <div class="contenedor">
          <div class="contacto revelar">
            <span class="ecualizador grande" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
            <h2 class="titulo-seccion">¿Construimos algo juntos?</h2>
            <p class="intro-seccion">
              Si buscas una aprendiz que llegue a construir, probar y aprender desde el primer día, hablemos.
            </p>
            <div class="acciones centradas">
              <a href={`mailto:${correo}`} class="boton boton-principal"><Icono nombre="correo" /> {correo}</a>
              <a href={linkedin} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="linkedin" /> LinkedIn</a>
              <a href={github} class="boton boton-secundario" target="_blank" rel="noopener"><Icono nombre="github" /> GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <span>© 2026 Manuela Córdoba Robledo</span>
        <span>Hecho con Astro y mucho ritmo · <a href="https://github.com/robledocordoba123-cmyk/portafolio" target="_blank" rel="noopener">código de este sitio</a></span>
      </div>
    </footer>

    <script>
      // Muestra cada bloque con una animación suave cuando entra en pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.revelar').forEach((el) => observador.observe(el));
    </script>
  </body>
</html>

<style>
  /* Navegación */
  .nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(5, 6, 5, .75); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(35, 43, 37, .7);
  }
  .nav-interior { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .marca { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 20px; }
  .ecualizador.pequeno { height: 18px; gap: 3px; }
  .ecualizador.pequeno span { width: 3px; }
  nav { display: flex; gap: 28px; font-size: 15px; color: var(--suave); }
  nav a:hover { color: var(--texto); }
  .nav-contacto { color: var(--texto); }

  /* Portada */
  .portada { position: relative; padding: 120px 0 100px; overflow: hidden; }
  .brillo {
    position: absolute; inset: -30% -10% auto auto; width: 720px; height: 720px;
    background: radial-gradient(circle, rgba(16, 185, 129, .28), transparent 60%);
    filter: blur(20px); pointer-events: none;
  }
  .brillo::after {
    content: ''; position: absolute; left: -380px; top: 260px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(74, 222, 128, .16), transparent 60%);
  }
  .portada-interior { position: relative; }
  .disponible {
    display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap;
    padding: 8px 16px; border-radius: 999px; background: var(--superficie); border: 1px solid var(--borde);
    font-size: 14px; color: var(--suave); margin-bottom: 30px;
  }
  h1 { font-size: clamp(42px, 7.2vw, 84px); max-width: 950px; margin-bottom: 26px; }
  h1 .ecualizador.grande { height: 0.8em; gap: 6px; margin-left: 12px; vertical-align: baseline; }
  h1 .ecualizador.grande span { width: 0.13em; }
  .lema { font-size: clamp(18px, 2.2vw, 21px); color: var(--suave); max-width: 700px; margin-bottom: 36px; }
  .lema strong { color: var(--texto); font-weight: 600; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .acciones.centradas { justify-content: center; }
  .icono-redondo {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--borde); background: var(--superficie); transition: border-color .2s, transform .2s;
  }
  .icono-redondo:hover { border-color: var(--acento); transform: translateY(-2px); }
  .cifras {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 70px;
    background: var(--borde); border: 1px solid var(--borde); border-radius: var(--radio); overflow: hidden;
  }
  .cifras div { background: var(--bg); padding: 24px; }
  .cifras dt { font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 700; }
  .cifras dd { color: var(--suave); font-size: 14px; }

  /* Proyectos */
  .lista-proyectos { display: grid; gap: 90px; margin-top: 64px; }
  .proyecto { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .proyecto.invertido .proyecto-visual { order: 2; }
  .proyecto-visual { position: relative; padding-bottom: 40px; }
  .ventana {
    border-radius: 14px; overflow: hidden; border: 1px solid var(--borde); background: var(--superficie);
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--color) 70%, transparent);
    transition: transform .4s ease;
  }
  .proyecto:hover .ventana { transform: translateY(-6px) rotate(-0.4deg); }
  .ventana-barra { display: flex; gap: 6px; padding: 10px 14px; background: var(--superficie-2); }
  .ventana-barra span { width: 10px; height: 10px; border-radius: 50%; background: var(--borde); }
  .extra {
    position: absolute; right: -18px; bottom: 0; width: 48%;
    border-radius: 12px; border: 1px solid var(--borde); box-shadow: 0 20px 50px -10px rgba(0, 0, 0, .7);
  }
  .extra.celular { width: 26%; border-radius: 22px; border: 5px solid #1c231e; }
  .proyecto-meta { display: flex; gap: 14px; align-items: center; color: var(--suave); font-size: 14px; margin-bottom: 10px; }
  .proyecto h3 { font-size: 40px; margin-bottom: 8px; }
  .frase { font-size: 19px; color: var(--texto); margin-bottom: 22px; }
  .caso dt { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--color); margin-top: 14px; }
  .caso dd { color: var(--suave); font-size: 15.5px; }
  .mini-cifras { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 22px 0 16px; font-size: 14px; color: var(--suave); }
  .mini-cifras strong { color: var(--texto); font-family: 'Space Grotesk', sans-serif; font-size: 18px; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }

  /* Ritmo */
  .ritmo { background: linear-gradient(180deg, transparent, var(--superficie) 30%, var(--superficie) 70%, transparent); }
  .pasos { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 54px; counter-reset: none; }
  .paso {
    position: relative; padding: 28px 24px; border-radius: var(--radio);
    background: var(--bg); border: 1px solid var(--borde); transition: border-color .3s, transform .3s;
  }
  .paso:hover { border-color: var(--acento); transform: translateY(-4px); }
  .paso-numero {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--degradado); color: #04120a; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; margin-bottom: 18px;
  }
  .paso h3 { font-size: 22px; margin-bottom: 8px; }
  .paso p { color: var(--suave); font-size: 15px; }

  /* Stack */
  .grupos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 44px; }
  .grupo { padding: 26px; border-radius: var(--radio); background: var(--superficie); border: 1px solid var(--borde); }
  .grupo h3 { font-size: 20px; margin-bottom: 16px; }
  .grupo .chips { margin-bottom: 0; }

  /* Sobre mí */
  .sobre-mi { display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px; align-items: start; }
  .foto {
    margin-top: 30px; max-width: 380px; aspect-ratio: 4 / 5; overflow: hidden;
    border-radius: 24px; border: 1px solid var(--borde);
    box-shadow: 0 30px 80px -30px rgba(16, 185, 129, .45);
  }
  .foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .sobre-mi-texto p { color: var(--suave); margin-bottom: 18px; font-size: 17.5px; }
  .datos { list-style: none; margin-top: 26px; border-top: 1px solid var(--borde); }
  .datos li { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--borde); font-size: 15.5px; }
  .datos span { width: 110px; flex-shrink: 0; color: var(--suave); }

  /* Contacto */
  .contacto {
    text-align: center; padding: 70px 30px; border-radius: 28px;
    background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, .22), transparent 60%), var(--superficie);
    border: 1px solid var(--borde);
  }
  .contacto .ecualizador { height: 40px; gap: 6px; margin-bottom: 22px; }
  .contacto .ecualizador span { width: 7px; }
  .contacto .intro-seccion { margin: 0 auto 32px; }

  .pie { border-top: 1px solid var(--borde); padding: 28px 0; color: var(--suave); font-size: 14px; }
  .pie-interior { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pie a { color: var(--texto); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    nav a:not(.nav-contacto) { display: none; }
    .proyecto, .proyecto.invertido { grid-template-columns: 1fr; gap: 36px; }
    .proyecto.invertido .proyecto-visual { order: 0; }
    .pasos { grid-template-columns: repeat(2, 1fr); }
    .sobre-mi { grid-template-columns: 1fr; gap: 10px; }
    .solo-escritorio { display: none; }
  }
  @media (max-width: 600px) {
    .portada { padding: 70px 0 70px; }
    .cifras { grid-template-columns: repeat(2, 1fr); }
    .pasos, .grupos { grid-template-columns: 1fr; }
    .proyecto h3 { font-size: 32px; }
    .extra { right: -6px; }
    .contacto .boton-principal { font-size: 13px; }
  }
</style>
